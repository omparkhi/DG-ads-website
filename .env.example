# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dgads?retryWrites=true&w=majority

# JWT Secret for Admin Session Signing
JWT_SECRET=your_jwt_secret_key_here

# Admin Fallback Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cloudinary Integration (Vite Client Variables)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

